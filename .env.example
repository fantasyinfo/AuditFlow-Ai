POSTGRES_USER=auditflow
POSTGRES_PASSWORD=change_me
POSTGRES_DB=auditflow
DATABASE_URL=postgresql+asyncpg://auditflow:change_me@db:5432/auditflow
SYNC_DATABASE_URL=postgresql+psycopg2://auditflow:change_me@db:5432/auditflow
REDIS_URL=redis://redis:6379/0

JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# LLM Settings (Google AI Studio Gemini API - Default)
LLM_PROVIDER=google
GEMINI_API_KEY=your_google_ai_studio_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=mock_key
LLM_MODEL=gemini-2.0-flash

EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=your_key_here
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=10
RATE_LIMIT_PER_MINUTE=120

