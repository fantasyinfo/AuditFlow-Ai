{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend"
    },
    "backend": {
      "root": ".",
      "entrypoint": "app/main.py"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/auth/(.*)", "destination": { "service": "backend" } },
    { "source": "/auth", "destination": { "service": "backend" } },
    { "source": "/documents/(.*)", "destination": { "service": "backend" } },
    { "source": "/documents", "destination": { "service": "backend" } },
    { "source": "/invoices/(.*)", "destination": { "service": "backend" } },
    { "source": "/invoices", "destination": { "service": "backend" } },
    { "source": "/projects/(.*)", "destination": { "service": "backend" } },
    { "source": "/projects", "destination": { "service": "backend" } },
    { "source": "/findings/(.*)", "destination": { "service": "backend" } },
    { "source": "/findings", "destination": { "service": "backend" } },
    { "source": "/rules/(.*)", "destination": { "service": "backend" } },
    { "source": "/rules", "destination": { "service": "backend" } },
    { "source": "/agent/(.*)", "destination": { "service": "backend" } },
    { "source": "/agent", "destination": { "service": "backend" } },
    { "source": "/system/(.*)", "destination": { "service": "backend" } },
    { "source": "/system", "destination": { "service": "backend" } },
    { "source": "/health", "destination": { "service": "backend" } },
    { "source": "/metrics", "destination": { "service": "backend" } },
    { "source": "/docs", "destination": { "service": "backend" } },
    { "source": "/openapi.json", "destination": { "service": "backend" } },
    { "source": "/ui/(.*)", "destination": { "service": "backend" } },
    { "source": "/ui", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
